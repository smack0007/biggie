func main(): int {
  var hello: string = "Hello";
  
  println("{} {}", hello, hello.length());
  println("{} {}", "hello", "hello".length());

  var world: string = " World";
  println("{} {}", hello + world, (hello + world).length());

  var exclamation: string = "!";
  println(hello + world + exclamation);

  return 0;
}