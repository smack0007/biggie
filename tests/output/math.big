func main(): int32 {
  println("{}", 1 + 2);
  println("{}", 2 - 1);
  println("{}", 21 * 2);
  println("{}", 42 / 2);
  println("{}", 1 + 2 * 3);
  println("{}", 4 * (2 + 3));

  var value: int32 = 42;

  value += 12;
  println("{}", value);

  value -= 24;
  println("{}", value);

  value *= 2;
  println("{}", value);

  value /= 6;
  println("{}", value);

  value = -value;
  println("{}", value);

  return 0;
}