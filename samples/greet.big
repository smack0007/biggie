import personLib "./person.big"

export enum GreetType {
  Formal = 1,
  Informal,
  Crazy
}

export func sayHello(person: personLib.Person, type: GreetType): void {
  if (type == GreetType.Formal) {
    println("Hello {}, you are {} years old!", person.name, person.age);
  } else if (type == GreetType.Informal) {
    println("Howdy {}, you are {} years old!", person.name, person.age);
  } else {
    println("Strap in {}, you are {} years old!", person.name, person.age);
  }
}
